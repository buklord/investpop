# ─────────────────────────────────────────────────────────────────────────────
# InvestPop — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
# Get this from: https://supabase.com → Project → Settings → Database → Connection String
# Use the "Transaction" pooler URL (port 6543).
#
# ⚠️  SPECIAL CHARACTERS IN PASSWORD: If your Supabase password contains @ # % ? &
#     you MUST percent-encode them, otherwise the URL parser breaks the connection.
#     Common encoding:  @  →  %40     #  →  %23     %  →  %25
#     Example — password "Pass@1128" becomes "Pass%401128" in the URL:
#     DATABASE_URL="postgresql://postgres:Pass%401128@db.<ref>.supabase.co:5432/postgres"
#
# ✅ DIRECT_URL is NOT required — DATABASE_URL is the only database variable needed.
#
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── Market Data (Twelve Data) ─────────────────────────────────────────────────
# Get a free key from: https://twelvedata.com/account/api-keys
# The platform auto-switches to Simulated Market mode if this is missing/exhausted.
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ── Session Secret ────────────────────────────────────────────────────────────
# Any long random string (32+ characters). Used to sign authentication cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_secret_string_here

# ── Public Base URL ───────────────────────────────────────────────────────────
# Set to your Vercel deployment URL (or Codespaces URL during development).
# Example: https://investpop.vercel.app
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Leave as * to allow all origins, or restrict to your domain.
CORS_ORIGINS=*

# ── Live Chat (Tawk.to) ───────────────────────────────────────────────────────
# Sign up free at https://tawk.to → Dashboard → Administration → Channels → Chat Widget
# OPTION A (recommended): paste the full embed URL shown in the Tawk.to embed snippet.
#   Example: https://embed.tawk.to/680abc12def34/1ikvn6t4a
NEXT_PUBLIC_TAWK_SRC=https://embed.tawk.to/6998b1189d60291c30385ff5/1jhu77ivk
#
# OPTION B (legacy): set the two IDs separately (both are required).
# NEXT_PUBLIC_TAWK_PROPERTY_ID=6998b1189d60291c30385ff5
# NEXT_PUBLIC_TAWK_WIDGET_ID=1jhu77ivk

# ── Legacy (not used in production) ──────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=investpop
