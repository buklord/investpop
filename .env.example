# ─────────────────────────────────────────────────────────────────────────────
# InvestPop — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project → Settings → Database → Connection String
# Use the "Transaction" pooler URL for DATABASE_URL (port 6543)
# Use the "Session" pooler or direct URL for DIRECT_URL
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# ── Market Data (Twelve Data) ─────────────────────────────────────────────────
# Get a free key from: https://twelvedata.com/account/api-keys
# The platform auto-switches to Simulated Market mode if this is missing/exhausted.
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ── Session Secret ────────────────────────────────────────────────────────────
# Any long random string (32+ characters). Used to sign authentication cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_secret_string_here

# ── Public Base URL ───────────────────────────────────────────────────────────
# Set to your Vercel deployment URL (or Codespaces URL during development).
# Example: https://investpop.vercel.app
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Leave as * to allow all origins, or restrict to your domain.
CORS_ORIGINS=*

# ── Legacy (not used in production) ──────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=investpop
